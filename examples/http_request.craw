sav 63 r01		; 0b0..0111111
sav 7 r02		; shift amount
cal shl r01 r02		; 0b0..01111110000000 (8064)
cal add 16 r01		; 8064+16 = 8080

io net port r01		; connect to port 8080

io net connect r10	; get socket id into r10

