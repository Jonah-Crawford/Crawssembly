sav 127 r01		; construct 200
cal add 73 r01		; 127+73 = 200
io net addr r01		; set message addr to 200

sav 54 r01
io net len r01		; set length to 54

io net send r11		; send http request

sav 127 r01		; construct 128
cal add 1 r01		; 127+1 = 128
io net len r01		; allow 128-byte response

sav 127 r01		; construct 300
cal add 127 r01		; 127+127 = 254
cal add 46 r01		; 254+46 = 300

io net addr r01		; save response to memory address 300

io net recv r10		; wait for response, get length into r10

io text int r10		; show length
io text newline rff	; drop cursor down

io text int ree		; show error code
io text newline rff	; drop cursor down

sav 127 r01		; construct 300
cal add 127 r01		; 127+127 = 254
cal add 46 r01		; 254+46 = 300
sav r01 r03		; save address

1			; print loop

  io mem addr r03	; access address
  io mem read r01	; read value
  io text char r01	; show character value

  cal add 1 r03		; address++
  sav r01 r03		; update address

  cal add -1 r10	; len--
  sav r01 r10		; update len

  jmg 1			; not done, continue

stp			; end response walker
