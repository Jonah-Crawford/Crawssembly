; CSL: screen/rectangle_fill.craw	r02/0d = x0	r11 = loop count
; Inputs: r02-r05			r03/0e = y0
; Outputs: None				r04/0f = x1
; Scope: r01-r11 | 60000-60003		r05/10 = y1

sav r02 r0d				; preserve corners...
sav r03 r0e				; ...from executestd...
sav r04 r0f				; ...screen/line.craw...
sav r05 r10				; ...function call

sav r0d r02				; x0 = x0
sav r0e r03				; y0 = y0
sav r0f r04				; x1 = x1
sav r0e r05				; y1 = y0 (AB)

executestd screen/line.craw		; draws AB segment

sav r0f r02				; x0 = x1
sav r10 r03				; y0 = y1
sav r0d r04				; x1 = x0
sav r10 r05				; y1 = y1 (CD)

executestd screen/line.craw		; draws CD segment

cal not r0d rff				; negation 1st step
cal add 1 r01				; negation 2nd step
cal add r0f r01				; x1 - x0

ifl 60000				; x1 - x0 < 0

  cal not r01 rff			; negation 1st step
  cal add 1 r01				; negation 1st step

rmv 60000				; end x1 - x0 < 0 check

sav r01 r11				; loop count = |x1 - x0|

60003					; fill loop

  sav r0e r03				; y0 = y0
  sav r10 r05				; y1 = y1

  sav r0d r02				; x0 = x
  sav r0d r04				; x1 = x

  executestd screen/line.craw		; draws line

  cal add 1 r0d				; incrememnt x
  sav r01 r0d				; update x

  cal add -1 r11			; decrement loop count
  sav r01 r11				; update loop count

  jmg 60003				; loop count > 0, continue
  jmz 60003				; edge case, 1 loop left

sav 0 r0d				; reset used registers
sav 0 r0e
sav 0 r0f
sav 0 r10
sav 0 r11
