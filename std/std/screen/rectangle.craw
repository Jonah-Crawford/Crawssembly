; CSL: screen/rectangle.craw	r02/0d = x0	A-----------------------B
; Inputs: r02-r05		r03/0e = y0	|			|
; Outputs: None			r04/0f = x1	|			|
; Scope: r01-r10 | 60000-60002	r05/10 = y1	D-----------------------C

sav r02 r0d				; preserve corners...
sav r03 r0e				; ...from executestd...
sav r04 r0f				; ...screen/line.craw...
sav r05 r10				; ...function call

sav r0d r02				; x0 = x0
sav r0e r03				; y0 = y0
sav r0f r04				; x1 = x1
sav r0e r05				; y1 = y0 (AB)

executestd screen/line.craw		; draws AB segment

sav r0f r02				; x0 = x1
sav r0e r03				; y0 = y0
sav r0f r04				; x1 = x1
sav r10 r05				; y1 = y1 (BC)

executestd screen/line.craw		; draws BC segment

sav r0f r02				; x0 = x1
sav r10 r03				; y0 = y1
sav r0d r04				; x1 = x0
sav r10 r05				; y1 = y1 (CD)

executestd screen/line.craw		; draws CD segment

sav r0d r02				; x0 = x0
sav r10 r03				; y0 = y1
sav r0d r04				; x1 = x0
sav r0e r05				; y1 = y0 (AD)

executestd screen/line.craw		; draws AD segment

sav 0 r0d				; reset used registers
sav 0 r0e
sav 0 r0f
sav 0 r10
