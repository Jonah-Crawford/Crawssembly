; CSL: heap/_alloc.craw			r02 = input	r06 = header
; Inputs: r02				r03 = address	r07 = flags
; Outputs: rec, ree			r04 = block size
; Scope: r01-r07, rec-red | 60000-60002	r05 = size

rmv 60000				; free label

sav 0 r01				; initialise registers
sav 0 r03
sav 0 r04
sav 0 r05
sav 0 r06
sav 0 r07

sav r02 r05				; preserve size

sav 1 r01				; 0b0..1
sav 16 r02				; shift amount
cal shl r01 r02				; 0b0..10000000000000000  (0x10000)
sav r01 r03				; save address

60000					; block walk loop

  sav 0 r07				; reset flags

  io mem addr r03			; set active memory

  sav 0 r06				; clear last header

  io mem read r06			; extract header
  sav r06 r01				; ready header

  ifz 60001				; header is empty, end of heap

    cal add 2 r07			; set end flag to true
    sav r01 r07				; update flags

  rmv 60001				; end header empty check

  sav 127 r01				; 0b0..01111111
  sav 7 r02				; shift amount
  cal shl r01 r02			; 0b0..0111110000000
  cal add 127 r01			; 0b0..0111111111111
  cal shl r01 r02			; 0b0..01111111111110000000
  cal add 126 r01			; 0b0..01111111111111111110

  cal and r06 r01			; extract size-flag part
  sav 1 r02				; shift amount
  cal shr r01 r02			; remove 0 from flag
  sav r01 r04				; preserve block size

  cal and 1 r06				; extract free flag  

  ifg 60001				; is free

    cal not r04 rff			; negation 1st step
    cal add 1 r01			; negation 2nd step
    cal add r05 r01			; size - block

    ifg 60002				; size > block, not suitable

      cal add r03 r04			; increase address by block size
      cal add 1 r01			; include header word
      sav r01 r03			; update address

      jmp 60000				; continue loop

    rmv 60002				; end not suitable check

    cal add 1 r07			; skip flag true
    sav r01 r07				; update flags 
   
    sav r03 rec				; update heap pointer

    sav 1 r02				; shift amount
    cal shl r05 r02			; create proper size header 

    io mem write r01			; creates header

    cal add r03 r05			; add block size to address
    cal add 1 r01			; include header address
    sav r01 r03				; update address

    io mem addr r03			; set active address to new header

    cal not r05 rff			; negation (skip +1 for header)
    cal add r04 r01			; block - size

    ifg 60002				; leftover > 1

      sav 1 r02				; shift amount
      cal shl r01 r02			; newsize << 1
      cal add 1 r01			; set free flag to true

      io mem write r01			; create new header from old block

    rmv 60002				; end leftover > 1 branch

    cal not r05 rff			; negation (skip +1 for header)
    cal add r04 r01			; block - size
    sav r01 r02				; preserve value

    ifz 60002				; exactly one unused word remains

      cal not r05 rff			; -requested - 1
      cal add r03 r01			; return to allocated header
      io mem addr r01			; set active address

      sav 0 r01				; makes sure to clear stale data

      io mem read r01			; get allocated header

      cal add 2 r01			; increase encoded size by one word
      io mem write r01			; update header

    rmv 60002				; end overlap check

  rmv 60001				; end is free check

  sav r07 r01				; ready flags

  ifz 60001				; not at end

    cal add r03 r04			; increase address by block size
    cal add 1 r01			; include header word
    sav r01 r03				; update address

    jmp 60000				; continue loop

  rmv 60001				; end all flags = false check
rmv 60000				; free label

sav 0 ree				; assume proper allocation occured

cal and 2 r07				; get end flag

ifg 60000				; no block found

  cal not red rff			; negation 1st step
  cal add 1 r01				; negation 2nd step
  cal add r03 r01			; address - stack pointer
  cal add r05 r01			; new_address - 1 - stack pointer
  cal add 1 r01				; new_address - stack_pointer

  sav 4 ree				; assume no room

  ifl 60001				; st > hp => room on heap
 
    sav 0 ree				; room found for new block

    sav r03 rec				; update heap pointer

    sav 1 r02				; shift amount
    cal shl r05 r02			; size << 1

    io mem addr rec			; set new block address
    io mem write r01			; write allocated header to new block

  rmv 60001				; room check

rmv 60000				; end no block found check

sav 0 r01				; clear used registers
sav 0 r02
sav 0 r03
sav 0 r04
sav 0 r05
sav 0 r06
sav 0 r07
