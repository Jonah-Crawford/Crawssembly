sav 100 r01		; creates 192.168.0.237 ip address in memory address 100
io mem addr r01
sav 127 r01
cal add 65 r01
io mem write r01

sav 101 r01
io mem addr r01
sav 127 r01
cal add 41 r01
io mem write r01

sav 102 r01
io mem addr r01
sav 0 r01
io mem write r01

sav 103 r01
io mem addr r01
sav 127 r01
cal add 110 r01
io mem write r01

sav 100 r01
io net ip r01		; set ip to address 100 in memory

sav 0 r01
io net protocol r01	; TCP protocol

sav 52 r01
sav 7 r02
cal shl r01 r02
cal add 111 r01
io net port r01		; port 6767

sav 127 r01		; construct 300
cal add 127 r01		; 127+127 = 254
cal add 46 r01		; 254+46 = 300
io net addr r01		; set net address to 300

sav 1 r01
io net block r01	; blocking mode

io net listen r10	; listen on port 6767

sav ree r03		; preserve io code

io text int r10
io text newline rff
io text int r03
io text newline rff

io net socket r10	; set socket from listen
io net accept r11	; accept data

sav ree r03		; preserve io code

io text int r10
io text newline rff
io text int r11
io text newline rff
io text int r03
io text newline rff

sav 127 r01		; construct 300
cal add 127 r01		; 127+127 = 254
cal add 46 r01		; 254+46 = 300
sav r01 r03		; save address

1			; print loop

  io mem addr r03	; access address
  io mem read r01	; read value
  io text char r01	; show character value

  cal add 1 r03		; address++
  sav r01 r03		; update address

  cal add -1 r10	; len--
  sav r01 r10		; update len

  jmg 1			; not done, continue

stp			; end response walker
