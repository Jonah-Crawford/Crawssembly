; read_16_inptus.craw
; Inputs: None
; Outputs: r0f-r1f
; Scope: r01-r02, r0f-r1f | 1, 10-24

1							; get 1st key loop

  io keyboard poll r01					; get last key pressed
  sav r01 r02						; preserve key press
  jmz 1							; no key pressed, continue looking

io text char r01					; show pressed key

rmv 1							; free label 1

cal add 5 r01						; -5 = Enter
ifz 1							; Enter pressed

  sav 1 r0f						; Enter flag is true

rmv 1							; end Enter pressed check

sav r0f r01						; ready Enter flag check
ifz 1							; Enter flag is false

  sav r02 r10						; preserve key press

rmv 1							; end Enter flag is false check

ifz 10							; Enter flag is false

  1							; get 2nd key loop

    io keyboard poll r01				; get last key pressed
    sav r01 r02						; preserve key press
    jmz 1						; no key pressed, continue looking

  io text char r01					; show pressed key

  rmv 1							; free label 1

  cal add 5 r01						; -5 = Enter
  ifz 1							; Enter pressed

    sav 2 r0f						; Enter flag is true

  rmv 1							; end Enter pressed check

  sav r0f r01						; ready Enter flag check
  ifz 1							; Enter flag is false

    sav r02 r11						; preserve key press

  rmv 1							; end Enter flag is false check

  ifz 11						; Enter flag is false

    1							; get 3rd key loop

      io keyboard poll r01				; get last key pressed
      sav r01 r02					; preserve key press
      jmz 1						; no key pressed, continue looking

    io text char r01					; show pressed key

    rmv 1						; free label 1

    cal add 5 r01					; -5 = Enter
    ifz 1						; Enter pressed

      sav 3 r0f						; Enter flag is true

    rmv 1						; end Enter pressed check

    sav r0f r01						; ready Enter flag check
    ifz 1						; Enter flag is false

      sav r02 r12					; preserve key press

    rmv 1						; end Enter flag is false check

    ifz 12						; Enter flag is false

      1							; get 4th key loop

        io keyboard poll r01				; get last key pressed
        sav r01 r02					; preserve key press
        jmz 1						; no key pressed, continue looking

      io text char r01					; show pressed key

      rmv 1						; free label 1

      cal add 5 r01					; -5 = Enter
      ifz 1						; Enter pressed

        sav 4 r0f					; Enter flag is true

      rmv 1						; end Enter pressed check

      sav r0f r01					; ready Enter flag check
      ifz 1						; Enter flag is false

        sav r02 r13					; preserve key press

      rmv 1						; end Enter flag is false check

      ifz 13						; Enter flag is false

        1						; get 5th key loop

          io keyboard poll r01				; get last key pressed
          sav r01 r02					; preserve key press
          jmz 1						; no key pressed, continue looking

        io text char r01				; show pressed key

        rmv 1						; free label 1

        cal add 5 r01					; -5 = Enter
        ifz 1						; Enter pressed

          sav 5 r0f					; Enter flag is true

        rmv 1						; end Enter pressed check

        sav r0f r01					; ready Enter flag check
        ifz 1						; Enter flag is false

          sav r02 r14					; preserve key press

        rmv 1						; end Enter flag is false check

        ifz 14						; Enter flag is false

          1						; get 6th key loop

            io keyboard poll r01			; get last key pressed
            sav r01 r02					; preserve key press
            jmz 1					; no key pressed, continue looking

          io text char r01				; show pressed key

          rmv 1						; free label 1

          cal add 5 r01					; -5 = Enter
          ifz 1						; Enter pressed

            sav 6 r0f					; Enter flag is true

          rmv 1						; end Enter pressed check

          sav r0f r01					; ready Enter flag check
          ifz 1						; Enter flag is false

            sav r02 r15					; preserve key press

          rmv 1						; end Enter flag is false check

          ifz 15					; Enter flag is false

            1						; get 7th key loop

              io keyboard poll r01			; get last key pressed
              sav r01 r02				; preserve key press
              jmz 1					; no key pressed, continue looking

            io text char r01				; show pressed key

            rmv 1					; free label 1

            cal add 5 r01				; -5 = Enter
            ifz 1					; Enter pressed

              sav 7 r0f					; Enter flag is true

            rmv 1					; end Enter pressed check

            sav r0f r01					; ready Enter flag check
            ifz 1					; Enter flag is false

              sav r02 r16				; preserve key press

            rmv 1					; end Enter flag is false check

            ifz 16					; Enter flag is false

              1						; get 8th key loop

                io keyboard poll r01			; get last key pressed
                sav r01 r02				; preserve key press
                jmz 1					; no key pressed, continue looking

              io text char r01				; show pressed key

              rmv 1					; free label 1

              cal add 5 r01				; -5 = Enter
              ifz 1					; Enter pressed

                sav 8 r0f				; Enter flag is true

              rmv 1					; end Enter pressed check

              sav r0f r01				; ready Enter flag check
              ifz 1					; Enter flag is false

                sav r02 r17				; preserve key press

              rmv 1					; end Enter flag is false check

              ifz 17					; Enter flag is false

                1					; get 9th key loop

                  io keyboard poll r01			; get last key pressed
                  sav r01 r02				; preserve key press
                  jmz 1					; no key pressed, continue looking

                io text char r01			; show pressed key

                rmv 1					; free label 1

                cal add 5 r01				; -5 = Enter
                ifz 1					; Enter pressed

                  sav 9 r0f				; Enter flag is true

                rmv 1					; end Enter pressed check

                sav r0f r01				; ready Enter flag check
                ifz 1					; Enter flag is false

                  sav r02 r18				; preserve key press

                rmv 1					; end Enter flag is false check

                ifz 18					; Enter flag is false

                  1					; get 10th key loop

                    io keyboard poll r01		; get last key pressed
                    sav r01 r02				; preserve key press
                    jmz 1				; no key pressed, continue looking

                  io text char r01			; show pressed key

                  rmv 1					; free label 1

                  cal add 5 r01				; -5 = Enter
                  ifz 1					; Enter pressed

                    sav 10 r0f				; Enter flag is true

                  rmv 1					; end Enter pressed check

                  sav r0f r01				; ready Enter flag check
                  ifz 1					; Enter flag is false

                    sav r02 r19				; preserve key press

                  rmv 1					; end Enter flag is false check

                  ifz 19				; Enter flag is false

                    1					; get 11th key loop

                      io keyboard poll r01		; get last key pressed
                      sav r01 r02			; preserve key press
                      jmz 1				; no key pressed, continue looking

                    io text char r01			; show pressed key

                    rmv 1				; free label 1

                    cal add 5 r01			; -5 = Enter
                    ifz 1				; Enter pressed

                      sav 11 r0f			; Enter flag is true

                    rmv 1				; end Enter pressed check

                    sav r0f r01				; ready Enter flag check
                    ifz 1				; Enter flag is false

                      sav r02 r1a			; preserve key press

                    rmv 1				; end Enter flag is false check

                    ifz 20				; Enter flag is false

                      1					; get 12th key loop

                        io keyboard poll r01		; get last key pressed
                        sav r01 r02			; preserve key press
                        jmz 1				; no key pressed, continue looking

                      io text char r01			; show pressed key

                      rmv 1				; free label 1

                      cal add 5 r01			; -5 = Enter
                      ifz 1				; Enter pressed

                        sav 12 r0f			; Enter flag is true

                      rmv 1				; end Enter pressed check

                      sav r0f r01			; ready Enter flag check
                      ifz 1				; Enter flag is false

                        sav r02 r1b			; preserve key press

                      rmv 1				; end Enter flag is false check

                      ifz 21				; Enter flag is false

                        1				; get 13th key loop

                          io keyboard poll r01		; get last key pressed
                          sav r01 r02			; preserve key press
                          jmz 1				; no key pressed, continue looking

                        io text char r01		; show pressed key

                        rmv 1				; free label 1

                        cal add 5 r01			; -5 = Enter
                        ifz 1				; Enter pressed

                          sav 13 r0f			; Enter flag is true

                        rmv 1				; end Enter pressed check

                        sav r0f r01			; ready Enter flag check
                        ifz 1				; Enter flag is false

                          sav r02 r1c			; preserve key press

                        rmv 1				; end Enter flag is false check

                        ifz 22				; Enter flag is false

                          1				; get 14th key loop

                            io keyboard poll r01	; get last key pressed
                            sav r01 r02			; preserve key press
                            jmz 1			; no key pressed, continue looking

                          io text char r01		; show pressed key

                          rmv 1				; free label 1

                          cal add 5 r01			; -5 = Enter
                          ifz 1				; Enter pressed

                            sav 14 r0f			; Enter flag is true

                          rmv 1				; end Enter pressed check

                          sav r0f r01			; ready Enter flag check
                          ifz 1				; Enter flag is false

                            sav r02 r1d			; preserve key press

                          rmv 1				; end Enter flag is false check

                          ifz 23			; Enter flag is false

                            1				; get 15th key loop

                              io keyboard poll r01	; get last key pressed
                              sav r01 r02		; preserve key press
                              jmz 1			; no key pressed, continue looking

                            io text char r01		; show pressed key

                            rmv 1			; free label 1

                            cal add 5 r01		; -5 = Enter
                            ifz 1			; Enter pressed

                              sav 15 r0f		; Enter flag is true

                            rmv 1			; end Enter pressed check

                            sav r0f r01			; ready Enter flag check
                            ifz 1			; Enter flag is false

                              sav r02 r1e		; preserve key press

                            rmv 1			; end Enter flag is false check

                            ifz 24			; Enter flag is false

                              1				; get 16th key loop

                                io keyboard poll r01	; get last key pressed
                                sav r01 r02		; preserve key press
                                jmz 1			; no key pressed, continue looking

                              io text char r01		; show pressed key

                              rmv 1			; free label 1

                              cal add 5 r01		; -5 = Enter
                              ifz 1			; Enter pressed

                                sav 16 r0f		; Enter flag is true

                              rmv 1			; end Enter pressed check

                              sav r0f r01		; ready Enter flag check
                              ifz 1			; Enter flag is false

                                sav r02 r1f		; preserve key press

                              rmv 1			; end Enter flag is false check

                            rmv 24			; end Enter flag is false check
                          rmv 23			; end Enter flag is false check
                        rmv 22				; end Enter flag is false check
                      rmv 21				; end Enter flag is false check
                    rmv 20				; end Enter flag is false check
                  rmv 19				; end Enter flag is false check
                rmv 18					; end Enter flag is false check
              rmv 17					; end Enter flag is false check
            rmv 16					; end Enter flag is false check
          rmv 15					; end Enter flag is false check
        rmv 14						; end Enter flag is false check
      rmv 13						; end Enter flag is false check
    rmv 12						; end Enter flag is false check
  rmv 11						; end Enter flag is false check
rmv 10							; end Enter flag is false check

rmv 1							; free label

;io text newline rff
;io text int r01
;io text newline rff
;io text int r0f
;io text newline rff

sav 0 r01						; clear used regs
sav 0 r02
