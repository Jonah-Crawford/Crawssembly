; execute_command.craw
; Inputs: reb
; Outputs: None
; Scope: Variable

sav r02 reb				; preserve code into highest register

cal add 0 reb				; 0 = exit
ifz 60100				; exit

  execute commands/exit.craw		; run exit

rmv 60100				; end exit branch

cal add -1 reb				; 1 = ls
ifz 60100				; ls

  execute commands/ls.craw		; run ls

rmv 60100				; end ls branch

cal add -2 reb				; 2 = clear
ifz 60100				; clear

  execute commands/clear.craw		; run clear

rmv 60100				; end clear branch

cal add -3 reb				; 3 = help
ifz 60100				; help

  execute commands/help.craw		; run help

rmv 60100				; end help branch

sav 0 r01				; clears lingering values
