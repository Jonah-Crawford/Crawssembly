; find_command.craw
; Inputs: rec
; Outputs: r02
; Scope: r01-r02 | 60010-6001X

sav -1 r02				; assume bad command

cal add 1 rec				; 1st char
io mem addr r01				; set char
io mem read r01				; read char

ifz 60010				; empty command

  sav -2 r02				; -2 = empty

rmv 60010				; end empty command check

cal add -101 r01			; 101 = e
ifz 60010				; e branch

  cal add 2 rec				; 2nd char
  io mem addr r01			; set char
  io mem read r01			; read char

  cal add -120 r01			; 120 = x
  ifz 60011				; ex branch

    cal add 3 rec			; 3rd char
    io mem addr r01			; set char
    io mem read r01			; read char

    cal add -105 r01			; 105 = i
    ifz 60012				; exi branch

      cal add 4 rec			; 4th char
      io mem addr r01			; set char
      io mem read r01			; read char

      cal add -116 r01			; 116 = t
      ifz 60013				; exit branch

        cal add 5 rec			; 5th char
        io mem addr r01			; set char
        io mem read r01			; read char

        ifz 60014			; 0 = end

          sav 0 r02			; exit = 0

        rmv 60014			; end clear command

        cal add -32 r01			; 32 = ' '
        ifz 60014			; exit command

          sav 0 r02			; exit = 0

        rmv 60014			; end exit command

      rmv 60013				; end exit branch
    rmv 60012				; end exi branch
  rmv 60011				; end ex branch
rmv 60010				; end e branch

cal add 1 rec				; 1st char
io mem addr r01				; set char
io mem read r01				; read char

cal add -108 r01			; 108 = l
ifz 60010				; l branch

  cal add 2 rec				; 2nd char
  io mem addr r01			; set char
  io mem read r01			; read char

  cal add -115 r01			; 115 = s
  ifz 60011				; ls branch

    cal add 3 rec			; 3rd char
    io mem addr r01			; set char
    io mem read r01			; read char

    ifz 60012				; 0 = end

      sav 1 r02				; ls = 1

    rmv 60012				; end ls command

    cal add -32 r01			; 32 = ' '
    ifz 60012				; ls command

      sav 1 r02				; ls = 1

    rmv 60012				; end ls command

  rmv 60011				; end ls branch
rmv 60010				; end l branch

cal add 1 rec				; 1st char
io mem addr r01				; set char
io mem read r01				; read char

cal add -99 r01				; 99 = c
ifz 60010				; c branch

  cal add 2 rec				; 2nd char
  io mem addr r01			; set char
  io mem read r01			; read char

  cal add -108 r01			; 108 = l
  ifz 60011				; cl branch

    cal add 3 rec			; 3rd char
    io mem addr r01			; set char
    io mem read r01			; read char

    cal add -101 r01			; 101 = e
    ifz 60012				; cle branch

      cal add 4 rec			; 4th char
      io mem addr r01			; set char
      io mem read r01			; read char

      cal add -97 r01			; 97 = a
      ifz 60013				; clea branch

        cal add 5 rec			; 5th char
        io mem addr r01			; set char
        io mem read r01			; read char

        cal add -114 r01		; 114 = r
        ifz 60014			; clear branch

          cal add 6 rec			; 6th char
          io mem addr r01		; set char
          io mem read r01		; read char

          ifz 60015			; 0 = end

            sav 2 r02			; clear = 2

          rmv 60015			; end clear command

          cal add -32 r01		; 32 = ' '
          ifz 60015			; clear command

            sav 2 r02			; clear = 2

          rmv 60015			; end clear command

        rmv 60014			; end clear branch
      rmv 60013				; end clea branch
    rmv 60012				; end cle branch
  rmv 60011				; end cl branch
rmv 60010				; end c branch

cal add 1 rec				; 1st char
io mem addr r01				; set char
io mem read r01				; read char

cal add -104 r01			; 104 = h
ifz 60010				; h branch

  cal add 2 rec				; 2nd char
  io mem addr r01			; set char
  io mem read r01			; read char

  cal add -101 r01			; 101 = e
  ifz 60011				; he branch

    cal add 3 rec			; 3rd char
    io mem addr r01			; set char
    io mem read r01			; read char

    cal add -108 r01			; 108 = l
    ifz 60012				; hel branch

      cal add 4 rec			; 4th char
      io mem addr r01			; set char
      io mem read r01			; read char

      cal add -112 r01			; 112 = p
      ifz 60013				; help branch

        cal add 5 rec			; 5th char
        io mem addr r01			; set char
        io mem read r01			; read char

        ifz 60014			; 0 = end

          sav 3 r02			; help = 3

        rmv 60014			; end help command

        cal add -32 r01			; 32 = ' '
        ifz 60014			; help command

          sav 3 r02			; help = 3

        rmv 60014			; end help command

      rmv 60013				; end help branch
    rmv 60012				; end hel branch
  rmv 60011				; end he branch
rmv 60010				; end h branch

cal add 1 rec				; 1st char
io mem addr r01				; set char
io mem read r01				; read char

cal add -100 r01			; 100 = d
ifz 60010				; d branch

  cal add 2 rec				; 2nd char
  io mem addr r01			; set char
  io mem read r01			; read char

  cal add -97 r01			; 97 = a
  ifz 60011				; da branch

    cal add 3 rec			; 3rd char
    io mem addr r01			; set char
    io mem read r01			; read char

    cal add -116 r01			; 116 = t
    ifz 60012				; dat branch

      cal add 4 rec			; 4th char
      io mem addr r01			; set char
      io mem read r01			; read char

      cal add -101 r01			; 101 = e
      ifz 60013				; date branch

        cal add 5 rec			; 5th char
        io mem addr r01			; set char
        io mem read r01			; read char

        ifz 60014			; 0 = end

          sav 4 r02			; date = 4

        rmv 60014			; end date command

        cal add -32 r01			; 32 = ' '
        ifz 60014			; date command

          sav 4 r02			; date = 4

        rmv 60014			; end date command

      rmv 60013				; end date branch
    rmv 60012				; end dat branch
  rmv 60011				; end da branch
rmv 60010				; end d branch

rmv 60010				; double check to free labels
rmv 60011
rmv 60012
rmv 60013
rmv 60014
rmv 60015

sav 0 r01				; reset used registers
